# このファイルをコピーして .env を作成し、各値を設定してください
# cp .env.example .env

# Flaskセッション署名に使う秘密鍵（必須）
# 生成方法: python -c "import secrets; print(secrets.token_hex(32))"
DSTT_SECRET_KEY=

# データベース接続URI（デフォルトはプロジェクト直下のSQLite）
DSTT_DATABASE_URI=sqlite:///users.db

# 開発時のみ True に設定（本番は False または未設定）
FLASK_DEBUG=false

# 旧来の固定管理者ユーザー名（既存DBの移行用・設定しなければ無効）
DSTT_LEGACY_ADMIN_USERNAME=
