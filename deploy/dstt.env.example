# Owner-only file, for example /etc/dstt/dstt.env or ~/.config/dstt/dstt.env.
DSTT_DATA_DIR=/home/asray/.local/share/dstt
DSTT_DATABASE_URI=sqlite:///users.db
DSTT_TRUSTED_HOSTS=dstt.dipalette.com,localhost,127.0.0.1
DSTT_PROXY_X_FOR=1
DSTT_PROXY_X_PROTO=1
DSTT_PROXY_X_HOST=1
DSTT_ACTIVITY_LOG_RETENTION_DAYS=365
DSTT_GUNICORN_ACCESSLOG=-
DSTT_GUNICORN_ERRORLOG=-

# PostgreSQL cut-over example (store the real password only in the protected
# deployment environment file):
# DSTT_DATABASE_URI=postgresql+psycopg://dstt:CHANGE_ME@127.0.0.1:5432/dstt
